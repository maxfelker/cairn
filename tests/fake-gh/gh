#!/usr/bin/env node
// A mock GitHub CLI for integration tests. Put this folder first on PATH and
// set FAKE_GH_STATE to a JSON file. The adapter then runs as usual, but
// against this file instead of GitHub.
//
// State file:
//   { repo, login, permission, issuesEnabled,
//     issueTypes: ["Task", "Bug", "Feature"] | [] | null (null: host has no types),
//     labels: [{name, color, description}],
//     issues: [{number, id, title, body, state: "OPEN"|"CLOSED", labels: [name],
//               type: name|null, parent: number|null, comments: [{author, body}],
//               pull: true when the number is a pull request, as GitHub's issues API returns them}],
//     pulls: [{number, state: "MERGED"|"OPEN"|"CLOSED", closes: [issue numbers],
//              head, title, body,     a pull with a body closes what GitHub would:
//                                     closing words in the body, and issues its branch is linked to
//              checks: [statusCheckRollup entries], reviewDecision, mergeable, mergeState,
//              behind: commits on main the head lacks, pendingReview: true when the viewer has one,
//              threads: [{id, resolved, outdated, path, line, comments: [{id, author, body}]}],
//              comments: [{id, author, body}] on the conversation, reviews: [{id, author, state, body}],
//              blockedBy: the message GitHub gives when a rule blocks the merge}],
//     mergeMethods: {merge, squash, rebase} (all true by default),
//
// With the full+json media type (`-H 'Accept: application/vnd.github.full+json'`),
// REST results add `body_html`, and GraphQL gives `bodyHTML`, as GitHub does.
// Each attached image becomes a signed private-user-images URL there.
//     linkedBranches: {"<issue number>": [branch names]},
//     calls: [[...argv]] }
//
// `gh issue develop` runs real git in the current directory, against the
// clone's own origin, as gh does.
//
// It models only what the adapter uses, with gh's real output and error text.
// Database ids differ from issue numbers on purpose (id = number + 9000), so
// using a number where GitHub wants an id fails here as it would for real.
// Anything else exits 64.

'use strict';

const fs = require('node:fs');
const { execFileSync } = require('node:child_process');

const STATE = process.env.FAKE_GH_STATE;
if (!STATE) {
  process.stderr.write('fake gh: FAKE_GH_STATE is not set\n');
  process.exit(64);
}

const state = JSON.parse(fs.readFileSync(STATE, 'utf8'));
state.labels = state.labels || [];
state.issues = (state.issues || []).map((i) => ({
  id: i.number + 9000, state: 'OPEN', labels: [], type: null, parent: null, comments: [], body: '', ...i,
}));
state.issueTypes = state.issueTypes === undefined ? [] : state.issueTypes;
state.subOrder = state.subOrder || {};
state.nextCommentId = state.nextCommentId || 7001;
for (const issue of state.issues) {
  issue.comments = issue.comments.map((c) => (c.id ? c : { ...c, id: state.nextCommentId++ }));
}
state.pulls = state.pulls || [];
state.linkedBranches = state.linkedBranches || {};
state.calls = state.calls || [];
const argv = process.argv.slice(2);
state.calls.push(argv);

function save() {
  fs.writeFileSync(STATE, JSON.stringify(state, null, 2));
}

function done(stdout, code = 0, stderr = '') {
  save();
  if (stdout) process.stdout.write(stdout);
  if (stderr) process.stderr.write(stderr);
  process.exit(code);
}

function unsupported(what) {
  done('', 64, `fake gh: unsupported ${what}: gh ${argv.join(' ')}\n`);
}

function json(value) {
  done(`${JSON.stringify(value)}\n`);
}

// gh api prints the error body to stdout and a summary to stderr.
function httpError(status, message) {
  done(`${JSON.stringify({ message, status: String(status) })}\n`, 1, `gh: ${message} (HTTP ${status})\n`);
}

const RANKS = ['READ', 'TRIAGE', 'WRITE', 'MAINTAIN', 'ADMIN'];
const atLeast = (level) => RANKS.indexOf(state.permission) >= RANKS.indexOf(level);

function requireLogin() {
  if (!state.login) {
    done('', 4, 'To get started with GitHub CLI, please run:  gh auth login\nAlternatively, populate the GH_TOKEN environment variable with a GitHub API authentication token.\n');
  }
}

function requireRepo(repo) {
  if (repo !== state.repo) {
    done('', 1, `GraphQL: Could not resolve to a Repository with the name '${repo}'. (repository)\n`);
  }
}

function rest(issue, full) {
  return {
    ...(full ? { body_html: renderHtml(issue.body) } : {}),
    id: issue.id,
    number: issue.number,
    title: issue.title,
    body: issue.body,
    state: issue.state.toLowerCase(),
    html_url: `https://github.com/${state.repo}/${issue.pull ? 'pull' : 'issues'}/${issue.number}`,
    labels: issue.labels.map((name) => ({ name })),
    type: issue.type ? { name: issue.type } : null,
    ...(issue.pull ? { pull_request: { url: `https://api.github.com/repos/${state.repo}/pulls/${issue.number}` } } : {}),
  };
}

function findIssue(number) {
  const issue = state.issues.find((i) => i.number === Number(number));
  if (!issue) httpError(404, 'Not Found');
  return issue;
}

// A parent's children in priority order: the recorded order first, then any
// other children by number.
function childrenOf(parentNumber) {
  const kids = state.issues.filter((i) => i.parent === parentNumber);
  const order = (state.subOrder[parentNumber] || []).filter((n) => kids.some((k) => k.number === n));
  const rest_ = kids.map((k) => k.number).filter((n) => !order.includes(n)).sort((a, b) => a - b);
  return [...order, ...rest_].map((n) => kids.find((k) => k.number === n));
}

// The issues a pull request closes on merge. A seeded pull without a body
// keeps its `closes` list. Otherwise GitHub's rules apply: a closing word
// before a reference anywhere in the body, plus every issue the head branch
// is linked to.
function closesOf(pull) {
  if (pull.body === undefined) return pull.closes || [];
  const found = new Set();
  const re = /\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?):?\s+#(\d+)/gi;
  for (let m = re.exec(pull.body); m; m = re.exec(pull.body)) found.add(Number(m[1]));
  for (const [n, branches] of Object.entries(state.linkedBranches)) {
    if (branches.includes(pull.head)) found.add(Number(n));
  }
  return [...found].filter((n) => state.issues.some((i) => i.number === n && !i.pull)).sort((a, b) => a - b);
}

// GitHub's rendering of a body, reduced to what Cairn reads: hidden
// comments are dropped, and each attached image, as an <img> tag or as
// Markdown, gets a signed URL with an escaped query, as GitHub serves it.
function renderHtml(body) {
  const signed = (url) => `https://private-user-images.githubusercontent.com/1/${url.split('/').pop()}.png?jwt=fake&amp;v=1`;
  let html = String(body || '').replace(/<!--[\s\S]*?-->/g, '');
  html = html.replace(/<img\b[^>]*>/gi, (tag) => {
    const src = (/src="([^"]*)"/.exec(tag) || [])[1] || '';
    const alt = (/alt="([^"]*)"/.exec(tag) || [])[1] || '';
    return `<a href="${signed(src)}"><img alt="${alt}" src="${signed(src)}"></a>`;
  });
  html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_, alt, src) => `<a href="${signed(src)}"><img alt="${alt}" src="${signed(src)}"></a>`);
  return `<p>${html.trim()}</p>`;
}

// A stable time for a seeded comment that has none: comment ids are in
// the order comments were made, so times follow them.
const timeOf = (c) => c.at || new Date(Date.UTC(2026, 0, 1) + Number(c.id) * 60000).toISOString();

const pullUrl = (n) => `https://github.com/${state.repo}/pull/${n}`;

function git(...args) {
  return execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
}

// Flags for `gh issue` and `gh pr`: every flag here takes a value, except
// the ones named in `bare`.
function parsePairs(args, bare = []) {
  const out = { _: [] };
  for (let i = 0; i < args.length; i += 1) {
    if (bare.includes(args[i])) out[args[i].replace(/^-+/, '')] = true;
    else if (args[i].startsWith('--')) out[args[i].slice(2)] = args[++i];
    else if (args[i] === '-R') out.repo = args[++i];
    else out._.push(args[i]);
  }
  return out;
}

function readInput() {
  return JSON.parse(fs.readFileSync(0, 'utf8'));
}

// Simple flag parsers for the two command groups.
function parseGhFlags(args) {
  const out = { _: [] };
  const value = { '-R': 'repo', '--repo': 'repo', '--json': 'json', '-c': 'color', '--color': 'color', '-d': 'description', '--description': 'description', '-h': 'hostname', '--hostname': 'hostname' };
  for (let i = 0; i < args.length; i += 1) {
    if (value[args[i]]) out[value[args[i]]] = args[++i];
    else if (args[i] === '--force' || args[i] === '-f') out.force = true;
    else if (args[i].startsWith('-')) unsupported(`flag ${args[i]}`);
    else out._.push(args[i]);
  }
  return out;
}

function parseApiFlags(args) {
  const out = { method: 'GET', fields: {}, path: null };
  for (let i = 0; i < args.length; i += 1) {
    const a = args[i];
    if (a === '-X' || a === '--method') out.method = args[++i];
    else if (a === '--input') out.input = args[++i];
    else if (a === '--paginate') out.paginate = true;
    else if (a === '--slurp') out.slurp = true;
    else if (a === '-H' || a === '--header') {
      const h = args[++i];
      if (h !== 'Accept: application/vnd.github.full+json') unsupported(`api header ${h}`);
      out.full = true;
    }
    else if (a === '-f' || a === '-F' || a === '--raw-field' || a === '--field') {
      const [k, ...v] = args[++i].split('=');
      out.fields[k] = a === '-F' && /^\d+$/.test(v.join('=')) ? Number(v.join('=')) : v.join('=');
    } else if (a.startsWith('-')) unsupported(`api flag ${a}`);
    else if (out.path === null) out.path = a;
    else unsupported(`extra argument ${a}`);
  }
  return out;
}

const [group, cmd, ...rest_] = argv;

if (group === 'auth' && cmd === 'status') {
  const hosts = state.login
    ? { 'github.com': [{ state: 'success', active: true, host: 'github.com', login: state.login, tokenSource: 'fake', scopes: 'repo' }] }
    : {};
  json({ hosts });
}

if (group === 'repo' && cmd === 'view') {
  const opts = parseGhFlags(rest_);
  requireLogin();
  requireRepo(opts._[0]);
  const methods = { merge: true, squash: true, rebase: true, ...(state.mergeMethods || {}) };
  const view = {
    nameWithOwner: state.repo,
    viewerPermission: state.permission,
    hasIssuesEnabled: state.issuesEnabled !== false,
    mergeCommitAllowed: methods.merge,
    squashMergeAllowed: methods.squash,
    rebaseMergeAllowed: methods.rebase,
  };
  json(Object.fromEntries(opts.json.split(',').map((f) => [f, view[f]])));
}

if (group === 'label' && cmd === 'create') {
  const opts = parseGhFlags(rest_);
  requireLogin();
  requireRepo(opts.repo);
  if (!atLeast('TRIAGE')) done('', 1, 'HTTP 403: Must have triage access to create labels\n');
  const name = opts._[0];
  const existing = state.labels.find((l) => l.name.toLowerCase() === name.toLowerCase());
  if (existing && !opts.force) {
    done('', 1, `label with name "${name}" already exists; use \`--force\` to update its color and description\n`);
  }
  const label = { name, color: opts.color || 'ededed', description: opts.description || '' };
  if (existing) Object.assign(existing, label);
  else state.labels.push(label);
  done(`✓ Label "${name}" created in ${state.repo}\n`);
}

if (group === 'issue' && cmd === 'develop') {
  const opts = parsePairs(rest_, ['--checkout', '--list']);
  requireLogin();
  requireRepo(opts.repo);
  const issue = state.issues.find((i) => i.number === Number(opts._[0]) && !i.pull);
  if (!issue) done('', 1, `GraphQL: Could not resolve to an Issue with the number of ${opts._[0]}. (repository.issue)\n`);
  const linked = state.linkedBranches[issue.number] || [];
  if (opts.list) {
    done(linked.map((b) => `${b}\thttps://github.com/${state.repo}/tree/${b}\n`).join(''));
  }
  if (!atLeast('WRITE')) done('', 1, 'GraphQL: Resource not accessible by integration (createLinkedBranch)\n');
  const slug = issue.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const name = opts.name || `${issue.number}-${slug}`;
  // GitHub makes the branch on the server, from the base branch as it is now.
  git('fetch', '-q', 'origin', opts.base || 'main');
  git('push', '-q', 'origin', `FETCH_HEAD:refs/heads/${name}`);
  state.linkedBranches[issue.number] = [...linked, name];
  if (opts.checkout) {
    git('fetch', '-q', 'origin', name);
    git('checkout', '-q', '-b', name, '--track', `origin/${name}`);
  }
  done(`github.com/${state.repo}/tree/${name}\n`);
}

if (group === 'pr') {
  if (!['list', 'create', 'edit', 'view', 'merge'].includes(cmd)) unsupported('command');
  const opts = parsePairs(rest_, ['--merge', '--squash', '--rebase']);
  for (const never of ['admin', 'auto', 'delete-branch']) {
    if (rest_.includes(`--${never}`)) unsupported(`flag --${never}, which Cairn must never pass`);
  }
  requireLogin();
  requireRepo(opts.repo);
  const findPull = (n) => {
    const pull = state.pulls.find((p) => p.number === Number(n));
    if (!pull) done('', 1, `GraphQL: Could not resolve to a PullRequest with the number of ${n}. (repository.pullRequest)\n`);
    return pull;
  };

  if (cmd === 'list') {
    const want = (opts.state || 'open').toUpperCase();
    const view = (p) => ({ number: p.number, url: pullUrl(p.number) });
    json(state.pulls.filter((p) => p.head === opts.head && p.state === want).map((p) => Object.fromEntries(opts.json.split(',').map((f) => [f, view(p)[f]]))));
  }

  if (cmd === 'create') {
    if (!atLeast('WRITE')) done('', 1, 'pull request create failed: GraphQL: Resource not accessible by integration (createPullRequest)\n');
    if (state.pulls.some((p) => p.head === opts.head && p.state === 'OPEN')) {
      done('', 1, `a pull request for branch "${opts.head}" into branch "${opts.base}" already exists\n`);
    }
    const number = [...state.issues, ...state.pulls].reduce((max, i) => Math.max(max, i.number), 0) + 1;
    state.pulls.push({ number, state: 'OPEN', head: opts.head, base: opts.base, title: opts.title, body: fs.readFileSync(0, 'utf8') });
    done(`${pullUrl(number)}\n`);
  }

  if (cmd === 'edit') {
    if (!atLeast('WRITE')) done('', 1, 'GraphQL: Resource not accessible by integration (updatePullRequest)\n');
    const pull = findPull(opts._[0]);
    if (opts.title !== undefined) pull.title = opts.title;
    if (opts['body-file'] !== undefined) pull.body = fs.readFileSync(0, 'utf8');
    done(`${pullUrl(pull.number)}\n`);
  }

  if (cmd === 'view') {
    const pull = findPull(opts._[0]);
    const view = {
      number: pull.number,
      url: pullUrl(pull.number),
      state: pull.state,
      createdAt: pull.opened || '2026-01-01T00:00:00.000Z',
      headRefName: pull.head,
      closingIssuesReferences: closesOf(pull).map((number) => ({ number })),
      statusCheckRollup: pull.checks || [],
      reviewDecision: pull.reviewDecision || '',
      mergeable: pull.mergeable || 'MERGEABLE',
      mergeStateStatus: pull.mergeState || 'CLEAN',
      mergeCommit: pull.mergeCommit ? { oid: pull.mergeCommit } : null,
    };
    json(Object.fromEntries(opts.json.split(',').map((f) => [f, view[f]])));
  }

  if (cmd === 'merge') {
    const pull = findPull(opts._[0]);
    const method = ['merge', 'squash', 'rebase'].filter((m) => opts[m]);
    if (method.length !== 1) done('', 1, '--merge, --rebase, or --squash required when not running interactively\n');
    if (!atLeast('WRITE')) done('', 1, 'GraphQL: Resource not accessible by integration (mergePullRequest)\n');
    if (pull.state === 'MERGED') done('', 1, `Pull request ${state.repo}#${pull.number} was already merged\n`);
    if (pull.blockedBy) done('', 1, `X Pull request ${state.repo}#${pull.number} is not mergeable: ${pull.blockedBy}\n`);
    if (pull.mergeable === 'CONFLICTING') done('', 1, `X Pull request ${state.repo}#${pull.number} is not mergeable: the merge commit cannot be cleanly created.\n`);
    pull.state = 'MERGED';
    pull.mergedWith = method[0];
    pull.mergeCommit = 'c0ffee0000000000000000000000000000000000';
    for (const n of closesOf(pull)) {
      const issue = state.issues.find((i) => i.number === n);
      if (issue) issue.state = 'CLOSED';
    }
    done(`✓ Merged pull request ${state.repo}#${pull.number}\n`);
  }

  unsupported('command');
}

if (group === 'api') {
  const opts = parseApiFlags(argv.slice(1));
  requireLogin();

  if (opts.path === 'graphql') {
    const q = opts.fields.query || '';
    if (/issueTypes/.test(q)) {
      requireRepo(`${opts.fields.owner}/${opts.fields.name}`);
      if (state.issueTypes === null) {
        done('', 1, "gh: Field 'issueTypes' doesn't exist on type 'Repository'\n");
      }
      json({ data: { repository: { issueTypes: { nodes: state.issueTypes.map((name) => ({ name, isEnabled: true })) } } } });
    }
    if (/closedByPullRequestsReferences/.test(q)) {
      requireRepo(`${opts.fields.owner}/${opts.fields.name}`);
      const n = Number(opts.fields.number);
      if (!state.issues.some((i) => i.number === n)) {
        done('', 1, `gh: Could not resolve to an Issue with the number of ${n}.\n`);
      }
      const nodes = (state.pulls || [])
        .filter((p) => closesOf(p).includes(n))
        .map((p) => ({ number: p.number, url: `https://github.com/${state.repo}/pull/${p.number}`, state: p.state }));
      json({ data: { repository: { issue: { closedByPullRequestsReferences: { nodes } } } } });
    }
    // One review thread by its global id, and a reply in it.
    const threadById = (id) => {
      for (const pull of state.pulls) {
        const th = (pull.threads || []).find((x) => x.id === id);
        if (th) return { pull, th };
      }
      return null;
    };
    const threadComment = (pull, c) => ({ databaseId: c.id, url: `${pullUrl(pull.number)}#discussion_r${c.id}`, body: c.body });
    if (/PullRequestReviewThread/.test(q) && /node\(id/.test(q)) {
      const found = threadById(opts.fields.id);
      if (!found) done('', 1, `gh: Could not resolve to a node with the global id of '${opts.fields.id}'.\n`);
      const { pull, th } = found;
      json({ data: { node: { id: th.id, isResolved: !!th.resolved, pullRequest: { number: pull.number, repository: { nameWithOwner: pull.repo || state.repo } }, comments: { nodes: th.comments.slice(-1).map((c) => threadComment(pull, c)) } } } });
    }
    if (/addPullRequestReviewThreadReply/.test(q)) {
      const found = threadById(opts.fields.id);
      if (!found) done('', 1, `gh: Could not resolve to a node with the global id of '${opts.fields.id}'.\n`);
      const { pull, th } = found;
      const c = { id: state.nextCommentId++, author: state.login, body: opts.fields.body };
      th.comments.push(c);
      json({ data: { addPullRequestReviewThreadReply: { comment: threadComment(pull, c) } } });
    }
    if (/resolveReviewThread|dismissPullRequestReview/.test(q)) unsupported('graphql mutation that Cairn must never run');
    if (/reviewThreads/.test(q)) {
      requireRepo(`${opts.fields.owner}/${opts.fields.name}`);
      const pull = state.pulls.find((p) => p.number === Number(opts.fields.number));
      if (!pull) done('', 1, `gh: Could not resolve to a PullRequest with the number of ${opts.fields.number}.\n`);
      const nodes = (pull.threads || []).map((th) => ({
        id: th.id,
        isResolved: !!th.resolved,
        isOutdated: !!th.outdated,
        path: th.path || null,
        line: th.line === undefined ? null : th.line,
        comments: { nodes: th.comments.map((c) => ({ databaseId: c.id, author: { login: c.author }, body: c.body, bodyHTML: renderHtml(c.body), url: `${pullUrl(pull.number)}#discussion_r${c.id}`, createdAt: timeOf(c) })) },
      }));
      const reviews = (pull.reviews || []).map((r) => ({ databaseId: r.id, author: { login: r.author }, state: r.state, body: r.body, bodyHTML: renderHtml(r.body), url: `${pullUrl(pull.number)}#pullrequestreview-${r.id}`, submittedAt: timeOf(r) }));
      const comments = (pull.comments || []).map((c) => ({ databaseId: c.id, author: { login: c.author }, body: c.body, bodyHTML: renderHtml(c.body), url: `${pullUrl(pull.number)}#issuecomment-${c.id}`, createdAt: timeOf(c) }));
      json({ data: { repository: { pullRequest: { pending: { totalCount: pull.pendingReview ? 1 : 0 }, reviews: { nodes: reviews }, comments: { nodes: comments }, reviewThreads: { nodes } } } } });
    }
    unsupported('graphql query');
  }

  const [pathPart, queryPart = ''] = opts.path.split('?');
  const query = Object.fromEntries(new URLSearchParams(queryPart));
  const restComment = (issue, c) => ({ ...(opts.full ? { body_html: renderHtml(c.body) } : {}), id: c.id, body: c.body, user: { login: c.author }, html_url: `https://github.com/${state.repo}/issues/${issue.number}#issuecomment-${c.id}`, created_at: timeOf(c) });

  const compare = /^repos\/([^/]+\/[^/]+)\/compare\/([^.]+)\.\.\.(.+)$/.exec(pathPart);
  if (compare && opts.method === 'GET') {
    requireRepo(compare[1]);
    const head = decodeURIComponent(compare[3]);
    const pull = state.pulls.find((p) => p.head === head && p.state === 'OPEN');
    if (!pull) httpError(404, 'Not Found');
    json({ behind_by: pull.behind || 0, ahead_by: 1, status: pull.behind ? 'diverged' : 'ahead' });
  }

  const editComment = /^repos\/([^/]+\/[^/]+)\/issues\/comments\/(\d+)$/.exec(pathPart);
  if (editComment && opts.method === 'PATCH') {
    requireRepo(editComment[1]);
    const id = Number(editComment[2]);
    const issue = state.issues.find((i) => i.comments.some((c) => c.id === id));
    if (!issue) httpError(404, 'Not Found');
    const c = issue.comments.find((x) => x.id === id);
    if (c.author !== state.login) httpError(403, 'Resource not accessible by integration');
    c.body = readInput().body;
    json(restComment(issue, c));
  }
  const m = /^repos\/([^/]+\/[^/]+)\/issues(?:\/(\d+))?(?:\/(comments|sub_issues|sub_issues\/priority|parent|labels))?$/.exec(pathPart);
  if (!m) unsupported(`api path ${opts.path}`);
  const [, repo, number, sub] = m;
  requireRepo(repo);
  const page = (items) => json(opts.paginate && opts.slurp ? [items] : items);

  if (!number && opts.method === 'GET') {
    const wantState = (query.state || 'open').toUpperCase();
    const labels = query.labels ? query.labels.split(',') : [];
    const items = state.issues
      .filter((i) => wantState === 'ALL' || i.state === wantState)
      .filter((i) => labels.every((l) => i.labels.includes(l)))
      .filter((i) => !query.type || (query.type === '*' ? i.type : query.type === 'none' ? !i.type : i.type === query.type))
      .sort((a, b) => b.number - a.number)
      .map(rest);
    page(items);
  }

  if (!number && opts.method === 'POST') {
    const body = readInput();
    if (state.issuesEnabled === false) httpError(410, 'Issues are disabled for this repo');
    if ((body.type || body.labels) && !atLeast('TRIAGE')) httpError(403, 'Must have triage access to set labels or types');
    if (body.type && !(state.issueTypes || []).includes(body.type)) {
      httpError(422, `Validation Failed: '${body.type}' is not a valid issue type for this repository`);
    }
    for (const l of body.labels || []) {
      if (!state.labels.some((x) => x.name === l)) httpError(422, `Validation Failed: label '${l}' does not exist`);
    }
    const n = state.issues.reduce((max, i) => Math.max(max, i.number), 0) + 1;
    const issue = {
      number: n, id: n + 9000, title: body.title, body: body.body || '', state: 'OPEN',
      labels: body.labels || [], type: body.type || null, parent: null, comments: [],
    };
    state.issues.push(issue);
    json(rest(issue));
  }

  if (number && !sub && opts.method === 'GET') json(rest(findIssue(number), opts.full));

  if (number && !sub && opts.method === 'PATCH') {
    const issue = findIssue(number);
    const body = readInput();
    for (const k of ['title', 'body', 'type']) if (k in body) issue[k] = body[k];
    json(rest(issue));
  }

  if (number && sub === 'comments' && opts.method === 'GET') {
    const issue = findIssue(number);
    page(issue.comments.map((c) => restComment(issue, c)));
  }

  if (number && sub === 'comments' && opts.method === 'POST') {
    const issue = findIssue(number);
    const c = { id: state.nextCommentId++, author: state.login, body: readInput().body };
    issue.comments.push(c);
    json(restComment(issue, c));
  }

  if (number && sub === 'labels' && opts.method === 'POST') {
    if (!atLeast('TRIAGE')) httpError(403, 'Must have triage access to add labels');
    const issue = findIssue(number);
    for (const l of readInput().labels) {
      if (!state.labels.some((x) => x.name === l)) httpError(422, `Validation Failed: label '${l}' does not exist`);
      if (!issue.labels.includes(l)) issue.labels.push(l);
    }
    json(issue.labels.map((name) => ({ name })));
  }

  if (number && sub === 'parent' && opts.method === 'GET') {
    const child = findIssue(number);
    if (!child.parent) httpError(404, 'No parent issue found');
    json(rest(findIssue(child.parent)));
  }

  if (number && sub === 'sub_issues' && opts.method === 'GET') {
    page(childrenOf(findIssue(number).number).map(rest));
  }

  if (number && sub === 'sub_issues/priority' && opts.method === 'PATCH') {
    if (!atLeast('TRIAGE')) httpError(403, 'Must have triage access to reprioritize sub-issues');
    const parent = findIssue(number);
    const body = readInput();
    const kids = childrenOf(parent.number);
    const byId = (id) => kids.find((k) => k.id === id);
    const child = byId(body.sub_issue_id);
    const anchor = byId(body.after_id !== undefined ? body.after_id : body.before_id);
    if (!child || !anchor) httpError(422, 'Validation Failed: sub_issue_id, after_id, and before_id must be sub-issues of this issue');
    const order = kids.map((k) => k.number).filter((n) => n !== child.number);
    const at = order.indexOf(anchor.number) + (body.after_id !== undefined ? 1 : 0);
    order.splice(at, 0, child.number);
    state.subOrder[parent.number] = order;
    json(rest(parent));
  }

  if (number && sub === 'sub_issues' && opts.method === 'POST') {
    if (!atLeast('TRIAGE')) httpError(403, 'Must have triage access to add sub-issues');
    const parent = findIssue(number);
    const child = state.issues.find((i) => i.id === opts.fields.sub_issue_id);
    if (!child) httpError(422, 'Validation Failed: sub_issue_id does not match an issue in this repository');
    if (child.parent === parent.number) httpError(422, 'Validation Failed: Issue may not contain duplicate sub-issues');
    if (child.parent) httpError(422, 'Validation Failed: Issue may only have one parent');
    child.parent = parent.number;
    state.subOrder[parent.number] = [...childrenOf(parent.number).map((k) => k.number).filter((n) => n !== child.number), child.number];
    json(rest(parent));
  }

  unsupported(`api ${opts.method} ${opts.path}`);
}

unsupported('command');
